# ============================================================
# MAXIMUS SOVEREIGN COMMAND — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Telegram Bot ─────────────────────────────────────────────
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ── Ollama LLM Service ───────────────────────────────────────
# Base URL for the local Ollama instance (Digital Sovereignty)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use for dispatch inference (e.g. mistral, llama3)
OLLAMA_MODEL=mistral

# ── Business Identity ────────────────────────────────────────
# Displayed in bot welcome messages
COMPANY_NAME=MAXIMUS SOVEREIGN COMMAND

# Primary contact / support username (no @)
SUPPORT_USERNAME=maximus_support

# ── Lead Logger ──────────────────────────────────────────────
# Directory where CSV/Excel lead files are written
LEADS_DIR=data

# ── Compliance ───────────────────────────────────────────────
# Quebec Bill 96 / Law 25 consent statement shown to new users
CONSENT_TEXT=En utilisant ce service, vous consentez à la collecte de données conformément à la Loi 25 du Québec. / By using this service, you consent to data collection in accordance with Quebec Law 25.
