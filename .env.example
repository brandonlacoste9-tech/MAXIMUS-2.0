# =============================================================================
# MAXIMUS SOVEREIGN COMMAND — Environment Configuration
# La Souveraineté Numérique au Service du Travail Québécois
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# --- Ollama (local LLM — Digital Sovereignty, no cloud tokens) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# --- Business Identity ---
BUSINESS_NAME=MAXIMUS
BUSINESS_TAGLINE=La Souveraineté Numérique au Service du Travail Québécois

# --- Lead Logging ---
# Path to the CSV file that stores leads (relative to project root)
LEADS_CSV_PATH=data/leads.csv

# --- System Prompts (override defaults if desired) ---
# DISPATCH_SYSTEM_PROMPT="You are MAXIMUS Dispatch..."
